{
  "name": "tekken-counter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "build:data": "node ../scripts/build-web-data.mjs",
    "verify": "node ../scripts/verify-web-lookups.mjs && node ../scripts/verify-web-dial.mjs",
    "verify:build": "node ../scripts/verify-build.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.14"
  }
}
